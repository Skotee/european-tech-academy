---
---

<section class="bg-surface pb-section">
  <div class="container-eta">
    <div
      class="relative isolate overflow-hidden rounded-3xl bg-brand-900 px-6 py-14 text-center sm:px-12 lg:px-16"
    >
      <div
        class="absolute inset-0 -z-10 opacity-25"
        style="background-image:linear-gradient(to right,#93aaff 1px,transparent 1px),linear-gradient(to bottom,#93aaff 1px,transparent 1px);background-size:48px 48px;mask-image:radial-gradient(ellipse 70% 90% at 50% 0%,black 20%,transparent 75%)"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute -bottom-24 left-1/2 -z-10 h-72 w-[48rem] -translate-x-1/2 rounded-full opacity-40 blur-3xl"
        style="background:radial-gradient(closest-side,#009efb,transparent 72%)"
        aria-hidden="true"
      >
      </div>

      <h2 class="mx-auto max-w-2xl text-3xl font-extrabold text-white sm:text-4xl">
        Masz pytania o kursy lub dofinansowanie? Porozmawiajmy.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-brand-100/85">
        Chętnie rozwiejemy Twoje wątpliwości — bez zobowiązań.
      </p>

      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href="/kontakt"
          class="inline-flex items-center justify-center rounded-xl bg-white px-6 py-3.5 text-base font-bold text-brand-900 shadow-lg shadow-brand-950/30 transition-all hover:-translate-y-0.5 hover:shadow-xl"
        >
          Skontaktuj się z nami
        </a>
        <a
          href="/rejestracja"
          class="inline-flex items-center justify-center rounded-xl border border-white/25 bg-white/5 px-6 py-3.5 text-base font-semibold text-white transition-colors hover:border-white/45 hover:bg-white/10"
        >
          Zapisz się na szkolenie
        </a>
      </div>
    </div>
  </div>
</section>
