---
const nav = [
  { label: "Kursy", href: "/kursy" },
  { label: "O nas", href: "/o-nas" },
  { label: "Aktualności", href: "/aktualnosci" },
  { label: "Galeria", href: "/galeria" },
  { label: "FAQ", href: "/faq" },
  { label: "Kariera", href: "/kariera" },
  { label: "Kontakt", href: "/kontakt" },
];

const langs = [
  { code: "PL", href: "/", label: "polski" },
  { code: "EN", href: "/en", label: "English" },
  { code: "UA", href: "/ua", label: "українська" },
  { code: "DE", href: "/de", label: "Deutsch" },
];
---

<header
  class="sticky top-0 z-50 border-b border-red-800 bg-red-600 backdrop-blur-md supports-backdrop-filter:bg-red-600/90"
>
  <div class="container-eta flex h-18 items-center gap-4">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="European Tech Academy — strona główna">
      <img src="/logo-eta.png" alt="" width="40" height="40" class="h-10 w-auto" />
      <span class="hidden text-[0.95rem] leading-tight font-extrabold text-white sm:block">
        European<br /><span class="text-red-100">Tech Academy</span>
      </span>
    </a>

    <nav aria-label="Nawigacja główna" class="ml-auto hidden items-center gap-1 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-3 py-2 text-sm font-medium text-white/90 transition-colors hover:bg-red-700 hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      <!-- Przelacznik jezyka -->
      <div class="relative hidden sm:block" data-lang-menu>
        <button
          type="button"
          class="flex items-center gap-1.5 rounded-lg border border-white/40 px-2.5 py-2 text-sm font-semibold text-white transition-colors hover:border-white hover:bg-red-700"
          aria-expanded="false"
          aria-haspopup="true"
          data-lang-trigger
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
          </svg>
          PL
        </button>
        <ul
          class="absolute right-0 mt-2 hidden w-40 overflow-hidden rounded-xl border border-border-subtle bg-surface-raised py-1 shadow-card"
          data-lang-list
        >
          {
            langs.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="flex items-center justify-between px-3 py-2 text-sm text-text-body transition-colors hover:bg-surface-muted hover:text-brand-700 dark:hover:text-brand-200"
                >
                  <span>{l.label}</span>
                  <span class="text-xs font-semibold text-text-muted">{l.code}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Motyw jasny / ciemny -->
      <button
        type="button"
        class="rounded-lg border border-white/40 p-2 text-white transition-colors hover:border-white hover:bg-red-700"
        aria-label="Przełącz motyw jasny/ciemny"
        data-theme-toggle
      >
        <svg class="size-4.5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="hidden size-4.5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" />
          <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8" />
        </svg>
      </button>

      <a
        href="/rejestracja"
        class="hidden rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-red-700 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-red-50 hover:shadow-md md:inline-flex"
      >
        Zapisz się
      </a>

      <button
        type="button"
        class="rounded-lg border border-white/40 p-2 text-white lg:hidden"
        aria-label="Otwórz menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menu mobilne -->
  <div class="hidden border-t border-border-subtle bg-surface lg:hidden" data-mobile-menu>
    <nav aria-label="Nawigacja mobilna" class="container-eta flex flex-col py-3">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-2 py-3 text-base font-medium text-text-body hover:bg-surface-muted"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/rejestracja"
        class="mt-2 rounded-lg bg-brand-600 px-4 py-3 text-center text-base font-semibold text-white"
      >
        Zapisz się na szkolenie
      </a>
      <div class="mt-3 flex gap-2 border-t border-border-subtle pt-3">
        {
          langs.map((l) => (
            <a
              href={l.href}
              class="rounded-md border border-border-subtle px-3 py-1.5 text-sm font-semibold text-text-body"
            >
              {l.code}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    // Motyw
    const toggle = document.querySelector("[data-theme-toggle]");
    toggle?.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("eta-theme", next);
      } catch {}
    });

    // Menu mobilne
    const menuBtn = document.querySelector("[data-menu-toggle]");
    const menu = document.querySelector("[data-mobile-menu]");
    menuBtn?.addEventListener("click", () => {
      const open = menu.classList.toggle("hidden");
      menuBtn.setAttribute("aria-expanded", String(!open));
      menuBtn.setAttribute("aria-label", open ? "Otwórz menu" : "Zamknij menu");
    });

    // Jezyki
    const langTrigger = document.querySelector("[data-lang-trigger]");
    const langList = document.querySelector("[data-lang-list]");
    langTrigger?.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = langList.classList.toggle("hidden");
      langTrigger.setAttribute("aria-expanded", String(!open));
    });
    document.addEventListener("click", (e) => {
      if (!langList || langList.classList.contains("hidden")) return;
      if (!e.target.closest("[data-lang-menu]")) {
        langList.classList.add("hidden");
        langTrigger?.setAttribute("aria-expanded", "false");
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      langList?.classList.add("hidden");
      langTrigger?.setAttribute("aria-expanded", "false");
    });
  })();
</script>
