---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: "left" | "center";
}
const { eyebrow, title, lead, align = "left" } = Astro.props;
---

<div class={align === "center" ? "mx-auto max-w-3xl text-center" : "max-w-3xl"}>
  {
    eyebrow && (
      <p class="text-xs font-bold tracking-[0.16em] text-brand-600 uppercase dark:text-brand-300">
        {eyebrow}
      </p>
    )
  }
  <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">{title}</h2>
  {lead && <p class="mt-4 text-lg leading-relaxed text-text-muted">{lead}</p>}
</div>
